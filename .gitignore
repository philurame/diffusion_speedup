__pycache__/

# Ignore model weights and pickle files
*.pt
*.pkl

# Ignore all files in DATA except for README.md and cifar_reference.pkl
/DATA/*
!/DATA/README.md
!/DATA/cifar_reference.pkl
!/Data/train_noise_8.pt
!/Data/val_noise_8.pt
/wandb/*

# Ignore all notebooks except the ones in the notebooks folder
*.ipynb
!/notebooks//*.ipynb